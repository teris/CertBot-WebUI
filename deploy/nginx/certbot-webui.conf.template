# CertBot WebUI — nginx TLS-Proxy
# HTTP-App: 127.0.0.1:__APP_PORT__ (oder 0.0.0.0:__APP_PORT__)
# HTTPS:    __HTTPS_PORT__  (kein 80/443 — Ports bleiben frei für andere Dienste)
# Managed by install.sh / enable-https.sh

upstream certbot_webui_upstream {
    server 127.0.0.1:__APP_PORT__;
    keepalive 8;
}

server {
    listen __HTTPS_PORT__ ssl http2;
    listen [::]:__HTTPS_PORT__ ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 20m;

    location / {
        proxy_pass http://certbot_webui_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port __HTTPS_PORT__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
